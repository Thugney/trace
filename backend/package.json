{
  "name": "family-learning-hub-backend",
  "version": "1.1.3",
  "description": "Backend API for Family Learning Hub",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/database/init.ts",
    "learn:validate": "tsx src/scripts/import-learn-content.ts --validate-only",
    "learn:import": "tsx src/scripts/import-learn-content.ts",
    "learn:sync-content": "tsx src/scripts/sync-learn-content.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "family",
    "pwa",
    "diet",
    "tasks"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@lumieducation/h5p-server": "^10.0.4",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "web-push": "^3.6.7",
    "image-size": "file:vendor/image-size-compat"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "supertest": "^6.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "vite": "^6.4.5"
  },
  "overrides": {
    "jsonpath": {
      "underscore": "^1.13.8"
    },
    "image-size": "$image-size"
  }
}
